# Copy this file to .env, then set it up for whichever backend you're using:
#   cp .env.example .env

# Which LLM backend the agents use: "openai" (default, needs an API key)
# or "ollama" (free, runs locally, needs Ollama installed and running).
LLM_PROVIDER=openai

# Optional: override the model name for whichever provider you picked
# above. Defaults: gpt-4o-mini for openai, llama3.2:3b for ollama.
# LLM_MODEL=gpt-4o-mini

# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=your_key_here
